{
  "name": "adigun-cabin-lighting",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && npm run typecheck:gateway && npm run typecheck:oem-sdk && vite build && node scripts/prepare-pages.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && npm run typecheck:gateway && npm run typecheck:oem-sdk",
    "typecheck:gateway": "tsc -p tsconfig.gateway.json --noEmit",
    "typecheck:oem-sdk": "tsc -p tsconfig.oem-sdk.json --noEmit",
    "build:oem-sdk": "tsc -p tsconfig.oem-sdk.json",
    "build:gateway": "tsc -p tsconfig.gateway.json",
    "gateway:start": "npm run build:gateway && node gateway/start.mjs",
    "operator:validate-scene": "npm run build:gateway && node scripts/validate-scene.mjs",
    "operator:diff-scenes": "npm run build:gateway && node scripts/diff-scenes.mjs",
    "lint": "eslint ."
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.19.1",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}


